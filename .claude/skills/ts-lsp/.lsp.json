{
	"typescript": {
		"command": "${CLAUDE_PROJECT_DIR}/node_modules/.bin/typescript-language-server",
		"args": ["--stdio"],
		"extensionToLanguage": {
			".ts": "typescript",
			".tsx": "typescriptreact",
			".mts": "typescript",
			".cts": "typescript",
			".js": "javascript",
			".jsx": "javascriptreact"
		},
		"workspaceFolder": "${CLAUDE_PROJECT_DIR}"
	}
}
