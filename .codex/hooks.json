{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/bin/check-publishable.py\" --hook",
            "timeout": 60,
            "statusMessage": "Checking the staged tree is publishable"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/bin/lab-register-hook.py\" --hook",
            "timeout": 30,
            "statusMessage": "Asking the lab register about that path"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/bin/finding-gate-hook.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking whether the finding gate applies"
          }
        ]
      }
    ]
  }
}
