#!/bin/sh
#
# Pre-commit checks for a public repository holding work on proprietary binaries.
#
# Install with `make hooks`, which points core.hooksPath here. That is per clone, so a fresh
# checkout has no hooks until someone runs it; the checks therefore also run in `make all`
# rather than living only here.
#
# What this is for, in order of how much it would hurt to get wrong:
#
#   1. A firmware or config binary, or a concordance dump, entering a public repository. The
#      .gitignore blocks the obvious names, but a rename, a `git add -f`, or a new extension
#      walks straight past it. This checks what is actually staged.
#   2. A third party's identity in a committed file. The archived .hfw packages carry a
#      stranger's Logitech UserId, account GUIDs and a session cookie.
#   3. Em-dashes and en-dashes in documents, which is a house convention.
#   4. Dependency versions specified as a range rather than pinned.
#
# Everything is checked against staged content (`git show :file`), not the working tree, so
# that a partially staged file cannot pass on the strength of an unstaged fix.
#
# Bypass with `git commit --no-verify`. There is no honest way to prevent that, and a check
# that cannot be bypassed gets uninstalled instead.

set -e

fail=0
note() { printf 'pre-commit: %s\n' "$1" >&2; fail=1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
# Every path the commit touches, a deletion or a rename included, for the checks that ask whether a kind of file
# changed at all rather than read what it now holds: a page or a source deleted changes what the pages must say.
touched=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$touched" ] || exit 0

# 1. Extensions that are proprietary binaries or personal dumps by definition. Mirrors
#    .gitignore, deliberately duplicated: this catches the case where .gitignore was edited in
#    the same commit that adds the file.
for f in $staged; do
	case "$f" in
	*.bin | *.hfw | *.EZHex | *.EZUp | *.EzHex | *.EzUpgrade | *.gpr | *-info.txt | *-safe.bin)
		note "$f is a firmware, config or dump file and cannot be committed" ;;
	# Third party binaries and anything extracted from one. Nothing in this project builds
	# these, so a staged one is always an accident.
	*.jar | *.class | *.dylib | *.jnilib | *.so)
		note "$f is a third party binary and cannot be committed" ;;
	esac
done

# 2. A third party's identity. The GUID pattern is what an account id looks like; the tags are
#    what Data.xml calls them. Both are checked with a value present, so prose that merely
#    names the fields (CLAUDE.md does) does not trip the check.
#
#    One legitimate exception exists and it is not rare enough to ignore: the scrubber's own
#    test needs fabricated values in the real fields' shape, or it is testing nothing. A file
#    carrying the marker below is exempt from this check, and the marker is deliberately
#    something you have to type on purpose next to a written reason. Note what it does not
#    exempt: check 1 still refuses binaries in such a file, and the marker is visible in the
#    diff, which is the point.
allow='pre-commit-allow-identity-sample'
guid='[0-9a-fA-F]\{8\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{12\}'
for f in $staged; do
	blob=$(git show ":$f" 2>/dev/null || true)
	[ -n "$blob" ] || continue
	if printf '%s' "$blob" | grep -qF "$allow"; then continue; fi
	if printf '%s' "$blob" | grep -qI "$guid"; then
		note "$f contains something shaped like an account GUID"
	fi
	if printf '%s' "$blob" | grep -qIE '<(UserId|CookieKeyValue|ServerID)>[^<]|ASPSESSIONID[A-Z]'; then
		note "$f contains an identity or session field with a value in it"
	fi
done

# 3. Em-dashes and en-dashes in documents.
for f in $staged; do
	case "$f" in
	*.md) ;;
	*) continue ;;
	esac
	n=$(git show ":$f" | python3 -c \
		"import sys; d=sys.stdin.read(); print(sum(d.count(c) for c in '—–'))")
	[ "$n" = "0" ] || note "$f has $n em-dash or en-dash characters"
done

# 4. Dependency ranges. Only when a manifest or the lock file is in the commit, so the usual
#    commit pays nothing for this. The rule and its reasoning live in the test itself.
case "$staged" in
*package.json* | *pnpm-lock.yaml*)
	if command -v node >/dev/null 2>&1; then
		node --test packages/lab/test/dependencies.test.ts >/dev/null 2>&1 ||
			note "a dependency is specified as a range: run node --test packages/lab/test/dependencies.test.ts"
	fi
	;;
esac

# 5. Documents contradicting the code. Only when a document is in the commit, so a code-only
#    commit pays nothing. An audit on 8 August 2026 found eleven places where a summary document
#    asserted something the code had stopped doing, and the reason none of them was caught is that
#    a summary is a copy of a fact with no test attached. tools/facts.py attaches one.
#
#    It runs against the working tree rather than staged content, unlike the checks above, and only
#    its phrase half, `--phrases`: the numeric half reads the local lab, which is private and grows
#    on its own, so a commit failed whenever another session added a dump (6 November 2026). The
#    numbers are checked by `make facts` and the full suite instead.
case "$staged" in
*.md*)
	if command -v python3 >/dev/null 2>&1; then
		python3 tools/facts.py --phrases >/dev/null 2>&1 ||
			note "a document restates a superseded claim: run python3 tools/facts.py --phrases"
	fi
	;;
esac

# 6. The SDK's pages on the website out of step with the packages. Only when the commit touches what they are made of
#    or checked by, a deletion or a rename included: a package's source or its `package.json`, whose exports decide
#    which subpaths need a page, an example or a document an example starts from, the generator, or a page of
#    `reference/sdk/`; another commit pays nothing. The pages are generated from the doc comments and the signatures,
#    so a comment changed without regenerating would publish the old one; the check takes about two seconds, and a
#    document an example starts from is held equal to the test setup it copies by the examples test's own check.
#    Against the working tree, like step 5: checking the staged content would mean writing the index out as a tree
#    of its own and reading every source of five packages there, which is not cheap, and `make all` and the site's
#    workflow, which check what is committed, catch what this misses.
case "$touched" in
*packages/*/src/* | *packages/*/package.json* | *packages/remote/examples/* | *packages/config/test/references/*-test.json* | \
	*reference/sdk/* | *packages/lab/bin/api-reference.ts*)
	if command -v node >/dev/null 2>&1; then
		node packages/lab/bin/api-reference.ts --check >/dev/null 2>&1 ||
			note "the SDK pages differ from the sources: run make api-reference-write"
		node --test --test-name-pattern='documents the examples start from' packages/remote/test/package/examples.test.ts \
			>/dev/null 2>&1 ||
			note "a document an example starts from differs from the test setup it copies: run node --test packages/remote/test/package/examples.test.ts"
	fi
	;;
esac

exit $fail
