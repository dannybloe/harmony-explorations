{
  "name": "Harmony Touch 7.1, the keys in Switch Box",
  "summary": "Every key Switch Box's map holds, tapped, then every long press held.",
  "description": "On the bench Harmony Touch holding work/touch-firmware/sets/6.9-label-back (the recorded full sync's documents under tags of ours, as put back by the own set and the changed set). Every expectation is derived from those documents by packages/bench/src/touchengine.ts, a model of the engine read in the firmware, and named as the monitor names a code of the Touch's own documents. Step 1 presses Off so no activity runs and the engine holds every device off; what it sends depends on what ran before and is not judged. Then Switch Box is started (judged as in the starts test) and every key its map binds is tapped, in groups from the top of the keypad, then every key with a long press is held for about 1 s. Predicted per key: the command the map binds, to the device it names (the volume keys to the activity's volume device); a key with a long press sends nothing when it goes down and its short command when let go inside about 0.55 s, its long command once held past that. A key the map does not bind sends nothing and is not pressed here. A tap held too long sends the long command instead: repeat the step and note it.",
  "steps": [
    {
      "instruction": "Button: Off"
    },
    {
      "instruction": "Activity: Switch Box",
      "expect": [
        {
          "device": "LG TV",
          "command": "PowerOn"
        },
        {
          "device": "KPN",
          "command": "PowerToggle",
          "pauseMs": [
            550,
            1100
          ]
        },
        {
          "device": "Switch",
          "command": "PowerOn",
          "pauseMs": [
            1550,
            2100
          ]
        },
        {
          "device": "Switch",
          "command": "Input2",
          "pauseMs": [
            1550,
            2100
          ]
        },
        {
          "device": "LG TV",
          "command": "InputHdmi3",
          "pauseMs": [
            5450,
            6250
          ]
        },
        {
          "device": "KPN",
          "command": "Info",
          "pauseMs": [
            550,
            1100
          ]
        },
        {
          "device": "KPN",
          "command": "7",
          "pauseMs": [
            2050,
            2600
          ]
        }
      ]
    },
    {
      "instruction": "Button: Menu → Button: Exit → Button: Info → Button: Guide → Button: Previous",
      "expect": [
        {
          "device": "KPN",
          "command": "Menu"
        },
        {
          "device": "KPN",
          "command": "Exit"
        },
        {
          "device": "KPN",
          "command": "Info"
        },
        {
          "device": "KPN",
          "command": "Guide"
        },
        {
          "device": "KPN",
          "command": "ChannelPrev"
        }
      ]
    },
    {
      "instruction": "Button: Up → Button: Down → Button: Left → Button: Right → Button: OK",
      "expect": [
        {
          "device": "KPN",
          "command": "DirectionUp"
        },
        {
          "device": "KPN",
          "command": "DirectionDown"
        },
        {
          "device": "KPN",
          "command": "DirectionLeft"
        },
        {
          "device": "KPN",
          "command": "DirectionRight"
        },
        {
          "device": "KPN",
          "command": "Select"
        }
      ]
    },
    {
      "instruction": "Button: Volume Up → Button: Volume Down → Button: Mute → Button: Channel Up → Button: Channel Down",
      "expect": [
        {
          "device": "LG TV",
          "command": "VolumeUp"
        },
        {
          "device": "LG TV",
          "command": "VolumeDown"
        },
        {
          "device": "LG TV",
          "command": "Mute"
        },
        {
          "device": "KPN",
          "command": "ChannelUp"
        },
        {
          "device": "KPN",
          "command": "ChannelDown"
        }
      ]
    },
    {
      "instruction": "Button: Red → Button: Green → Button: Yellow → Button: Blue",
      "expect": [
        {
          "device": "KPN",
          "command": "Red"
        },
        {
          "device": "KPN",
          "command": "Green"
        },
        {
          "device": "KPN",
          "command": "Yellow"
        },
        {
          "device": "KPN",
          "command": "Blue"
        }
      ]
    },
    {
      "instruction": "Button: Rewind → Button: Play → Button: Pause → Button: Fast Forward → Button: Stop → Button: Record → Button: DVR",
      "expect": [
        {
          "device": "KPN",
          "command": "Rewind"
        },
        {
          "device": "KPN",
          "command": "Play"
        },
        {
          "device": "KPN",
          "command": "Pause"
        },
        {
          "device": "KPN",
          "command": "FastForward"
        },
        {
          "device": "KPN",
          "command": "Stop"
        },
        {
          "device": "KPN",
          "command": "Record"
        },
        {
          "device": "KPN",
          "command": "DVR"
        }
      ]
    },
    {
      "instruction": "Button: Rewind, hold 1 s",
      "expect": [
        {
          "device": "KPN",
          "command": "Replay"
        }
      ]
    },
    {
      "instruction": "Button: Off",
      "expect": [
        {
          "device": "LG TV",
          "command": "Mute"
        },
        {
          "device": "LG TV",
          "command": "PowerOff",
          "pauseMs": [
            150,
            700
          ]
        },
        {
          "device": "KPN",
          "command": "PowerToggle",
          "pauseMs": [
            550,
            1100
          ]
        },
        {
          "device": "Switch",
          "command": "PowerOff",
          "pauseMs": [
            1550,
            2100
          ]
        }
      ]
    }
  ]
}
