{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist"
  },
  // The library. The tests are a project of their own, `test/tsconfig.json`, for the reason
  // `packages/usb/tsconfig.json` gives: a test says which requirement it proves through the test kit, which is built
  // on this package, so one project holding both would form a cycle `tsc --build` refuses.
  "include": ["src/**/*.ts"]
}
