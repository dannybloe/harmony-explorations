{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist"
  },
  // The helpers the tests of several packages share, moved out of `packages/usb/test`, which exported them
  // through its package.json, so that test helpers live in a kit no product imports, plan 013 decision 6. It
  // references `packages/usb`'s library project and not its tests, `packages/usb/test/tsconfig.json`, which
  // reference this one in turn. `packages/base` for the one byte comparison.
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../base" }, { "path": "../lab" }, { "path": "../usb" }]
}
