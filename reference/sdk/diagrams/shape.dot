digraph shape {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.3, nodesep=0.35, ranksep=0.5, fontname="Helvetica"];
  node [shape=plaintext, fontname="Helvetica", fontsize=12, fontcolor="#1f2328", color="#57606a"];
  edge [fontname="Helvetica", fontsize=11, fontcolor="#1f2328", color="#57606a", arrowsize=0.7];
  Recipe [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>Recipe</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT">version?  <FONT FACE="Courier">number</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT">about?  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT" BGCOLOR="#eef4fb">model  <FONT FACE="Courier">RecipeModel</FONT></TD></TR><TR><TD PORT="r3" ALIGN="LEFT" BGCOLOR="#eef4fb">devices  <FONT FACE="Courier">RecipeDevice[]</FONT></TD></TR><TR><TD PORT="r4" ALIGN="LEFT" BGCOLOR="#eef4fb">activities  <FONT FACE="Courier">RecipeActivity[]</FONT></TD></TR><TR><TD PORT="r5" ALIGN="LEFT">favourites?  <FONT FACE="Courier">RecipeFavourites[]</FONT></TD></TR><TR><TD PORT="r6" ALIGN="LEFT">choices?  <FONT FACE="Courier">Readonly&lt;Record&lt;string, unknown&gt;&gt;</FONT></TD></TR><TR><TD PORT="r7" ALIGN="LEFT">protocols?  <FONT FACE="Courier">Readonly&lt;Record&lt;string, unknown&gt;&gt;[]</FONT></TD></TR><TR><TD PORT="r8" ALIGN="LEFT" BGCOLOR="#eef4fb">settings?  <FONT FACE="Courier">Readonly&lt;Record&lt;string, RecipeSetting&gt;&gt;</FONT></TD></TR><TR><TD PORT="r9" ALIGN="LEFT">highestIds?  <FONT FACE="Courier">RecipeIds</FONT></TD></TR></TABLE>>];
  RecipeModel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeModel</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT">name  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT">skin?  <FONT FACE="Courier">number</FONT></TD></TR></TABLE>>];
  RecipeDevice [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeDevice</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT">id?  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT">name  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT">device  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r3" ALIGN="LEFT">poweredOnBetweenActivities?  <FONT FACE="Courier">boolean</FONT></TD></TR><TR><TD PORT="r4" ALIGN="LEFT">key?  <FONT FACE="Courier">RecipeDeviceKey</FONT></TD></TR><TR><TD PORT="r5" ALIGN="LEFT" BGCOLOR="#eef4fb">keys?  <FONT FACE="Courier">RecipeKey[]</FONT></TD></TR><TR><TD PORT="r6" ALIGN="LEFT">definition?  <FONT FACE="Courier">RecipeDefinition</FONT></TD></TR><TR><TD PORT="r7" ALIGN="LEFT">timing?  <FONT FACE="Courier">Partial&lt;DeviceTiming&gt;</FONT></TD></TR><TR><TD PORT="r8" ALIGN="LEFT">power?  <FONT FACE="Courier">RecipeDevicePower</FONT></TD></TR><TR><TD PORT="r9" ALIGN="LEFT">channelTuning?  <FONT FACE="Courier">DeviceChannelTuning</FONT></TD></TR><TR><TD PORT="r10" ALIGN="LEFT" BGCOLOR="#eef4fb">screen?  <FONT FACE="Courier">RecipeScreenCommand[]</FONT></TD></TR><TR><TD PORT="r11" ALIGN="LEFT">commands?  <FONT FACE="Courier">Readonly&lt;Record&lt;string, RecipeCommand&gt;&gt;</FONT></TD></TR></TABLE>>];
  RecipeActivity [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeActivity</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT">id?  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT">name  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT">type  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r3" ALIGN="LEFT" BGCOLOR="#eef4fb">devices  <FONT FACE="Courier">RecipeActivityDevice[]</FONT></TD></TR><TR><TD PORT="r4" ALIGN="LEFT" BGCOLOR="#eef4fb">screen?  <FONT FACE="Courier">RecipeScreenItem[]</FONT></TD></TR><TR><TD PORT="r5" ALIGN="LEFT" BGCOLOR="#eef4fb">keys?  <FONT FACE="Courier">RecipeKey[]</FONT></TD></TR><TR><TD PORT="r6" ALIGN="LEFT">opensOn?  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r7" ALIGN="LEFT">favourites?  <FONT FACE="Courier">boolean</FONT></TD></TR><TR><TD PORT="r8" ALIGN="LEFT">powerOrder?  <FONT FACE="Courier">string[]</FONT></TD></TR><TR><TD PORT="r9" ALIGN="LEFT">start?  <FONT FACE="Courier">RecipeActivityStep[]</FONT></TD></TR><TR><TD PORT="r10" ALIGN="LEFT">end?  <FONT FACE="Courier">RecipeActivityStep[]</FONT></TD></TR><TR><TD PORT="r11" ALIGN="LEFT">sequences?  <FONT FACE="Courier">RecipeSequence[]</FONT></TD></TR><TR><TD PORT="r12" ALIGN="LEFT">enabled?  <FONT FACE="Courier">false</FONT></TD></TR><TR><TD PORT="r13" ALIGN="LEFT">attention?  <FONT FACE="Courier">RecipeAttention[]</FONT></TD></TR></TABLE>>];
  RecipeActivityDevice [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeActivityDevice</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT">device  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT">input?  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT">roles  <FONT FACE="Courier">ActivityRoleName[]</FONT></TD></TR></TABLE>>];
  RecipeKey [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeKey</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT">key  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT">press?  <FONT FACE="Courier">RecipePress</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT" BGCOLOR="#eef4fb">action  <FONT FACE="Courier">RecipeKeyAction</FONT></TD></TR></TABLE>>];
  RecipeKeyAction [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeKeyAction</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT"><FONT FACE="Courier">{ device: string; command: string }</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT"><FONT FACE="Courier">{ sequence: string }</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT"><FONT FACE="Courier">{ nothing: true }</FONT></TD></TR></TABLE>>];
  RecipeScreenItem [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeScreenItem</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT" BGCOLOR="#eef4fb"><FONT FACE="Courier">RecipeScreenCommand</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT"><FONT FACE="Courier">{ sequence: string; steps: RecipeSequenceStep[] }</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT"><FONT FACE="Courier">{ sequence: string; steps?: undefined }</FONT></TD></TR></TABLE>>];
  RecipeScreenCommand [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeScreenCommand</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT">device  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT">command  <FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT">label?  <FONT FACE="Courier">string</FONT></TD></TR></TABLE>>];
  RecipeSetting [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5"><B>RecipeSetting</B></TD></TR><TR><TD PORT="r0" ALIGN="LEFT"><FONT FACE="Courier">string</FONT></TD></TR><TR><TD PORT="r1" ALIGN="LEFT"><FONT FACE="Courier">number</FONT></TD></TR><TR><TD PORT="r2" ALIGN="LEFT"><FONT FACE="Courier">boolean</FONT></TD></TR></TABLE>>];
  Recipe:r2 -> RecipeModel;
  Recipe:r3 -> RecipeDevice;
  Recipe:r4 -> RecipeActivity;
  Recipe:r8 -> RecipeSetting;
  RecipeDevice:r5 -> RecipeKey;
  RecipeDevice:r10 -> RecipeScreenCommand;
  RecipeActivity:r3 -> RecipeActivityDevice;
  RecipeActivity:r4 -> RecipeScreenItem;
  RecipeActivity:r5 -> RecipeKey;
  RecipeKey:r2 -> RecipeKeyAction;
  RecipeScreenItem:r0 -> RecipeScreenCommand;
}
