digraph sync {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.3, nodesep=0.35, ranksep=0.5, fontname="Helvetica"];
  node [shape=plaintext, fontname="Helvetica", fontsize=12, fontcolor="#1f2328", color="#57606a"];
  edge [fontname="Helvetica", fontsize=11, fontcolor="#1f2328", color="#57606a", arrowsize=0.7];
  compound=true;
  subgraph cluster_compiled {
    label=<<B>a remote sent one configuration file</B>>; style=rounded; color="#57606a"; margin=12;
    compiled_identify [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">identify</FONT></TD></TR></TABLE>>];
    compiled_check [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">check</FONT></TD></TR></TABLE>>];
    compiled_build [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">build</FONT></TD></TR></TABLE>>];
    compiled_backup [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">backup</FONT></TD></TR></TABLE>>];
    compiled_write [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">write</FONT></TD></TR></TABLE>>];
    compiled_verify [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">verify</FONT></TD></TR></TABLE>>];
    compiled_restart [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">restart</FONT></TD></TR></TABLE>>];
    compiled_identify -> compiled_check -> compiled_build -> compiled_backup -> compiled_write -> compiled_verify -> compiled_restart;
  }
  subgraph cluster_document {
    label=<<B>a remote sent documents</B>>; style=rounded; color="#57606a"; margin=12;
    document_identify [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">identify</FONT></TD></TR></TABLE>>];
    document_check [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">check</FONT></TD></TR></TABLE>>];
    document_build [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">build</FONT></TD></TR></TABLE>>];
    document_hand_over [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">hand-over</FONT></TD></TR></TABLE>>];
    document_write [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#eef4fb" ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">write</FONT></TD></TR></TABLE>>];
    document_identify -> document_check -> document_build -> document_hand_over -> document_write;
  }
  outcome [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#d6e4f5" ALIGN="LEFT" BALIGN="LEFT"><B>the outcome</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">SyncOutcome</FONT></TD></TR></TABLE>>];
  compiled_restart -> outcome [ltail=cluster_compiled, label=" from any phase"];
  document_write -> outcome [ltail=cluster_document, label=" from any phase"];
  left_new_configuration [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT"><B>the remote holds the new configuration</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">new-configuration</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">written</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">either kind</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT>: <FONT FACE="Courier">restart-owed</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">a configuration file only, may be unplugged</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT>: <FONT FACE="Courier">restart-withheld</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">a configuration file only, do not unplug, not reached by any model yet</FONT></TD></TR></TABLE>>];
  outcome -> left_new_configuration;
  left_as_before [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT"><B>the remote as it was</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">as-before</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">nothing-to-write</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">a configuration file only</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">dry-run</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">either kind</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">stopped</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">either kind</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">refused</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">either kind</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">either kind</FONT></TD></TR></TABLE>>];
  outcome -> left_as_before;
  left_needs_recovery [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#57606a"><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT"><B>the remote needs its recovery</B><BR/><FONT POINT-SIZE="10" COLOR="#57606a">needs-recovery</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT>: <FONT FACE="Courier">write-unfinished</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">a configuration file only, do not unplug</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT>: <FONT FACE="Courier">neighbour-erased</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">a configuration file only, do not unplug</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT>: <FONT FACE="Courier">read-back-failed</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">a configuration file only, do not unplug</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT>: <FONT FACE="Courier">stopped-in-hand-over</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">documents only, do not unplug</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="Courier">failed</FONT>: <FONT FACE="Courier">stopped-after-hand-over</FONT><BR/><FONT POINT-SIZE="10" COLOR="#57606a">documents only, do not unplug</FONT></TD></TR></TABLE>>];
  outcome -> left_needs_recovery;
}
